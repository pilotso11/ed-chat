{
  "name": "ed-chat",
  "version": "0.8.0",
  "private": true,
  "description": "Claude Code or Codex chat overlay for Elite Dangerous on Windows",
  "license": "MIT",
  "author": "Seth Osher",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run format:check && npm run coverage",
    "compare:providers": "tsx scripts/compare-agents.ts --provider scripts/providers/zai.json --run claude:sonnet --run claude:opus --run codex:gpt-6.2-sol --run claude:glm-5.3@zai --run codex:glm-5.3@zai",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "koffi": "^3.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ed-mcp": "0.9.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "28.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.2.3": true,
    "koffi@3.3.7": true
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
